# Lighthouse AI Web App
# Copy this file to .env.local and fill in real values.

# --- Auth (required) --------------------------------------------------------

# The shared password operators type at /login.
OPERATOR_PASSWORD=change-me

# At least 32 chars. Used to seal the iron-session cookie. Rotate to invalidate
# every active login. Generate with: openssl rand -hex 32
SESSION_PASSWORD=change-me-to-at-least-32-characters-long

# --- Optional ---------------------------------------------------------------

# Per-cookie audit rate limit in audits per hour (default 30).
RATE_LIMIT_AUDITS_PER_HOUR=30

# Override the SQLite location (default: ./data/lighthouse.db).
# LIGHTHOUSE_DB_PATH=/var/lib/lighthouse/lighthouse.db

# Personal-default OpenAI key. When the dashboard's "OpenAI API Key" field is
# left blank, the server falls back to this value so a single-operator setup
# can run AI insights without re-pasting the key every audit.
#
# IMPORTANT for shared / cloud deployments: leave this UNSET so each operator
# is required to supply their own key from the UI. Otherwise every team
# member's audits run against (and bill) this one account.
# OPENAI_API_KEY=sk-your-personal-key-here

# Vercel bypass token override (also accepted per audit via the UI).
# VERCEL_BYPASS_TOKEN=

# Next.js
NODE_ENV=development
